DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retail_erp?schema=public"

# Optional: protect a hosted deployment with HTTP Basic Auth (both must be set)
# BASIC_AUTH_USER="admin"
# BASIC_AUTH_PASSWORD=""

# Production start (npm run start:prod) seeds demo data when the DB is empty; set to "false" to disable
# SEED_IF_EMPTY="true"

# Seed catalog: unset = prisma/data/demo-catalog.json (anonymized) if present,
# "builtin" = the 52 hand-written demo products, or a path to a catalog JSON
# SEED_CATALOG=""

# Google Sheets import (npm run sheets:import -- <real|anonymize>)
# Share the spreadsheet with the service account's client_email.
# Locally point at the key file (keep it OUTSIDE the repo); on a host paste the JSON (raw or base64).
# GOOGLE_SERVICE_ACCOUNT_FILE="/path/outside/repo/service-account.json"
# GOOGLE_SERVICE_ACCOUNT_JSON=""
# POS_STOCK_SHEET="<spreadsheet id or URL of the POS0021 stock report>"

# Export reports to Google Sheets (npm run sheets:export, or the dashboard button).
# The spreadsheet must be shared with the service account as Editor.
# SHEETS_EXPORT_SHEET="<spreadsheet id or URL>"
# Optional: "false" hides the dashboard export button (scheduled export still runs)
# SHEETS_EXPORT_BUTTON="true"
# Optional: export automatically every day at this Asia/Taipei time while the server runs
# SHEETS_EXPORT_DAILY_AT="07:00"
# Optional: label written on the 摘要 tab (defaults to local vs hosted)
# SHEETS_EXPORT_SOURCE=""

# Automation (n8n) — endpoints under /api/integrations/* require "Authorization: Bearer <INTEGRATION_TOKEN>"
# INTEGRATION_TOKEN=""
# Base URL used for links inside notification e-mails
# APP_URL="https://your-erp.example.com"
# n8n webhook that receives { event: "count.completed", … } when a stock count is completed
# N8N_COUNT_COMPLETED_WEBHOOK=""
# Drive folder (id) holding the POS reports, for /api/integrations/new-reports
# POS_REPORTS_FOLDER=""
