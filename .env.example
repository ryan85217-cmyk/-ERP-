DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retail_erp?schema=public"

# Optional: protect a hosted deployment with HTTP Basic Auth (both must be set)
# BASIC_AUTH_USER="admin"
# BASIC_AUTH_PASSWORD=""

# Production start (npm run start:prod) seeds demo data when the DB is empty; set to "false" to disable
# SEED_IF_EMPTY="true"
