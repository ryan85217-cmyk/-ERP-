{
  "name": "retail-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate",
    "db:start": "node scripts/dev-db.mjs",
    "start:prod": "node scripts/start.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.544.0",
    "next": "15.5.27",
    "prisma": "6.16.2",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-is": "19.1.9",
    "recharts": "2.15.4",
    "tailwind-merge": "3.3.1",
    "tsx": "4.20.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "20.19.17",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "embedded-postgres": "17.9.0-beta.16",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  },
  "overrides": {
    "react-is": "19.1.9"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
