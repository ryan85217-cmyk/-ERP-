    "genericAuthType": "httpHeaderAuth",
    "options": {},
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ transactions: $json.transactions }) }}"
   },
   "credentials": {
    "httpHeaderAuth": {
