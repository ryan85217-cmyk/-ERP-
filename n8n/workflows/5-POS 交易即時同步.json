   "typeVersion": 2.2,
   "position": [
    780,
    100
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "ca158ac8-41ba-4f53-9db8-9ca21ddd12a3",
       "leftValue": "={{ $json.count }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "fe06cdaa-48e4-4523-a085-d6ad030c11b0",
   "name": "ERP：寫入交易",
