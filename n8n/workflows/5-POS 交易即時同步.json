   "typeVersion": 4.2,
   "position": [
    520,
    100
   ],
   "parameters": {
    "method": "GET",
    "url": "https://smart-store-erp.zeabur.app/api/mock-pos/v1/transactions",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {},
    "sendQuery": true,
    "queryParameters": {
     "parameters": [
      {
       "name": "since",
       "value": "={{ $json.since }}"
      },
      {
       "name": "until",
       "value": "={{ $json.until }}"
      }
     ]
    }
   },
   "credentials": {
    "httpHeaderAuth": {
     "name": "ERP API token"
    }
   }
  },
  {
   "id": "29a80056-7e5e-4baf-821f-6dd88614f06c",
   "name": "有新交易",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    780,
    100
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "bc7f4d6a-0774-49b8-b69a-f5f3a0c02d78",
       "leftValue": "={{ $json.count }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "701231b9-7ae8-4cef-941c-1c320ac1f1d5",
   "name": "ERP：寫入交易",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1040,
    100
   ],
   "parameters": {
    "method": "POST",
    "url": "https://smart-store-erp.zeabur.app/api/integrations/pos/transactions",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {},
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ transactions: $json.transactions }) }}"
   },
   "credentials": {
    "httpHeaderAuth": {
     "name": "ERP API token"
    }
   }
  }
 ],
