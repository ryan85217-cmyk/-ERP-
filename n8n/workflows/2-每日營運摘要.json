    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {}
   },
   "credentials": {
    "httpHeaderAuth": {
     "name": "ERP API token"
    }
   }
  },
  {
   "id": "f28d2f90-cab5-4d31-be37-ba07802538a1",
   "name": "寄 Gmail",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
   "position": [
    520,
    100
   ],
   "parameters": {
    "fromEmail": "智慧門市 ERP <ryan85217@gmail.com>",
    "toEmail": "ryan85217@gmail.com",
    "subject": "={{ $json.subject }}",
    "emailFormat": "html",
    "html": "={{ $json.html }}",
    "options": {}
   },
   "credentials": {
    "smtp": {
